{
  "name": "uilint-semantic",
  "version": "0.2.146",
  "description": "LLM-powered styleguide checking for UILint",
  "author": "Peter Suggate",
  "repository": {
    "type": "git",
    "url": "https://github.com/peter-suggate/uilint.git",
    "directory": "packages/uilint-semantic"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./eslint-rules": {
      "types": "./dist/eslint-rules/index.d.ts",
      "import": "./dist/eslint-rules/index.js"
    },
    "./eslint-rules/register": {
      "types": "./dist/eslint-rules/register.d.ts",
      "import": "./dist/eslint-rules/register.js"
    },
    "./eslint-rules/semantic": {
      "types": "./dist/eslint-rules/semantic/index.d.ts",
      "import": "./dist/eslint-rules/semantic/index.js"
    },
    "./cli-manifest": {
      "types": "./dist/cli-manifest.d.ts",
      "import": "./dist/cli-manifest.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "lint": "eslint src/",
    "lint:strict": "eslint src/ --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "uilint-core": "workspace:*",
    "uilint-eslint": "workspace:*"
  },
  "dependencies": {
    "@typescript-eslint/typescript-estree": "^8.35.1",
    "glob": "^11.0.0",
    "xxhash-wasm": "^1.1.0"
  },
  "optionalDependencies": {
    "ollama": "^0.6.3"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsup": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
